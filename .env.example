# Copie para .env e preencha. Nunca commite .env com chaves reais.

# === Resend (envio de e-mails) ===
# Chave da API do Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# === Brevo (opcional, prioridade sobre Resend quando configurado) ===
# Chave API: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib_xxxxxxxxxxxx
# E-mail remetente — precisa ser de domínio verificado no Resend.
# Se não configurar, usa onboarding@resend.dev (só funciona para seu próprio e-mail no plano free).
RESEND_FROM_EMAIL=no-reply@syntexabr.com.br
# E-mail destino para notificações internas (admin). Se não configurar, usa VEREDA_ADMIN_EMAIL.
RESEND_TO_EMAIL=admin@syntexabr.com.br

# === Stripe (obrigatório para checkout) ===
STRIPE_SECRET_KEY=sk_live_...ou_sk_test_...
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_MEDIUM=price_xxx
STRIPE_PRICE_MASTER=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Opcional: URL do frontend para redirect após pagamento
FRONTEND_BASE_URL=https://syntexabr.com.br

# === Backend ===
VEREDA_SECRET_KEY=...
VEREDA_ADMIN_EMAIL=admin@...
VEREDA_ADMIN_PASSWORD=...

# === LLM (Hetzner: Ollama na 11434) ===
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
DEFAULT_LLM=ollama
