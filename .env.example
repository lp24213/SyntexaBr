# Copie para .env e preencha. Nunca commite .env com chaves reais.
# Produção: tudo em /opt/syntexa/.env na VM Azure (backend, workers, nginx). Não use .env do laptop em build público.
# "127.0.0.1" no servidor = este mesmo host (uvicorn na 8000, gateways locais nas portas que configurar), não o teu PC.

# === Resend (envio de e-mails) ===
# Chave da API do Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# === Brevo (opcional, prioridade sobre Resend quando configurado) ===
# Chave API: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib_xxxxxxxxxxxx
# E-mail remetente — precisa ser de domínio verificado no Resend.
# Se não configurar, usa onboarding@resend.dev (só funciona para seu próprio e-mail no plano free).
RESEND_FROM_EMAIL=no-reply@syntexabr.com.br
# E-mail destino para notificações internas (admin). Se não configurar, usa VEREDA_ADMIN_EMAIL.
RESEND_TO_EMAIL=admin@syntexabr.com.br

# === Stripe (obrigatório para checkout) ===
STRIPE_SECRET_KEY=sk_live_...ou_sk_test_...
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_MEDIUM=price_xxx
STRIPE_PRICE_MASTER=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Opcional: URL do frontend para redirect após pagamento
FRONTEND_BASE_URL=https://syntexabr.com.br
# Após OAuth GitHub, o backend redireciona para esta rota (use a mesma do site, ex. rota ofuscada).
# FRONTEND_OAUTH_RETURN_PATH=/B_4mhVUCNloA
# GitHub SSO (OAuth)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Callback no GitHub app (Authorization callback URL):
# GITHUB_OAUTH_CALLBACK_URL=https://api.syntexabr.com.br/v1/auth/github/callback
# Integrações API (limite por token por minuto)
# INTEGRATION_TOKEN_RPM=60

# === Frontend (build Cloudflare Pages — prefixo NEXT_PUBLIC_) ===
# API pública (obrigatório alinhar com o backend no ar). Ex.: https://api.syntexabr.com.br quando o DNS apontar para o Container App.
# NEXT_PUBLIC_API_BASE=https://api.syntexabr.com.br
# Contact form email destination
# NEXT_PUBLIC_CONTACT_EMAIL=contato@syntexabr.com.br
# Imagem no browser: Puter.js (tenta até ~4K; sem chave no backend). Desligar: NEXT_PUBLIC_USE_PUTER_IMAGES=0
# NEXT_PUBLIC_USE_PUTER_IMAGES=1
# NEXT_PUBLIC_PUTER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Download apps (frontend / página de download)
# NEXT_PUBLIC_SITE_URL=https://syntexabr.com.br
# NEXT_PUBLIC_DESKTOP_MAC_URL=https://syntexabr.com.br/download/SyntexaAI-macos-universal.dmg
# NEXT_PUBLIC_DESKTOP_LINUX_URL=https://syntexabr.com.br/download/SyntexaAI-linux-x64.tar.gz
# NEXT_PUBLIC_DESKTOP_UBUNTU_URL=https://syntexabr.com.br/download/SyntexaAI-ubuntu-22.04-amd64.deb
# NEXT_PUBLIC_ANDROID_APK_URL=https://syntexabr.com.br/download/SyntexaAI-android-arm64.apk
# NEXT_PUBLIC_ANDROID_AAB_URL=
# NEXT_PUBLIC_IOS_APPSTORE_URL=
# NEXT_PUBLIC_IOS_TESTFLIGHT_URL=
# iOS direto (somente enterprise/MDM/ad-hoc): precisa .ipa assinado + manifest plist
# NEXT_PUBLIC_IOS_DIRECT_IPA_URL=
# NEXT_PUBLIC_IOS_DIRECT_MANIFEST_URL=
# Black Forest Labs (imagem): provedor primário no backend com fallback automático
# BFL_API_KEY=bfl_xxx
# BFL_API_URL=https://api.us1.bfl.ai/v1/{model}
# BFL_MODEL=flux-pro-1.1
# BFL_TIMEOUT_SEC=90
# MEDIA_REALISM_ENHANCE_PROMPTS=true
# MEDIA_IMAGE_TARGET_RESOLUTION=2048x2048
# MEDIA_IMAGE_QUALITY=ultra
# MEDIA_IMAGE_NEGATIVE_PROMPT=lowres, blurry, watermark, artifacts, cartoonish, toy-like geometry, flat icon style
# MEDIA_VIDEO_TARGET_RESOLUTION=1920x1080
# MEDIA_VIDEO_TARGET_FPS=30
# MEDIA_VIDEO_TARGET_DURATION_SEC=8
# MEDIA_VIDEO_QUALITY=cinematic
# MEDIA_VIDEO_NEGATIVE_PROMPT=blurry, jitter, flicker, low-detail, unrealistic anatomy, flat geometric-only scenes
# MEDIA_GENERATION_CACHE_ENABLED=true
# MEDIA_GENERATION_CACHE_TTL_SEC=300
# MEDIA_QUEUE_VIDEO_ENABLED=true
# MEDIA_QUEUE_MUSIC_ENABLED=true
# MEDIA_QUEUE_VIDEO_TIMEOUT_SEC=900
# MEDIA_QUEUE_MUSIC_TIMEOUT_SEC=900
# Geração assíncrona: rate limit (Redis), idempotência, prioridade ARQ (_defer_by), contexto p/ cache no GET
# MEDIA_ASYNC_RATE_LIMIT_ENABLED=true
# MEDIA_ASYNC_RATE_LIMIT_WINDOW_SEC=60
# MEDIA_ASYNC_RATE_LIMIT_ANON=24
# MEDIA_ASYNC_RATE_LIMIT_FREE=40
# MEDIA_ASYNC_RATE_LIMIT_BASIC=60
# MEDIA_ASYNC_RATE_LIMIT_PAID=120
# MEDIA_IDEMPOTENCY_TTL_SEC=86400
# MEDIA_JOB_CONTEXT_TTL_SEC=7200
# MEDIA_ARQ_DEFER_SEC_ADMIN=0
# MEDIA_ARQ_DEFER_SEC_PAID=0.12
# MEDIA_ARQ_DEFER_SEC_BASIC=0.55
# MEDIA_ARQ_DEFER_SEC_FREE=1.0
# MEDIA_ARQ_DEFER_SEC_ANON=1.6
# Endpoints assíncronos de mídia (/v1/media/*/generate-async) usam REDIS_URL+worker ARQ.

# === Backend ===
# Produção: obrigatório (validação falha se fracos)
ENVIRONMENT=production
VEREDA_SECRET_KEY=...
VEREDA_ADMIN_EMAIL=admin@...
VEREDA_ADMIN_PASSWORD=...

# === Uvicorn (API) — ver scripts/run_uvicorn_prod.sh ===
# Workers >1 exige PostgreSQL (SQLite fica em 1). VM com 4+ vCPUs + PG: UVICORN_WORKERS=3
UVICORN_WORKERS=1
UVICORN_TIMEOUT_KEEPALIVE=120
# Opcional: USE_GUNICORN=1 usa gunicorn com uvicorn.workers.UvicornWorker (Linux produção)
# USE_GUNICORN=0

# === Banco de dados (produção: PostgreSQL na Azure, não SQLite) ===
# Azure Database for PostgreSQL Flexible Server: uma ÚNICA instância partilhada por TODAS as VMs (2 nós, 10 nós, etc.).
# No portal: Rede / firewall → permitir os IPs públicos de cada VM (e “Allow Azure services” se aplicável).
# Formato (user admin do PG na Azure muitas vezes é "nome@nome-servidor" → codificar @ na password com %40):
# DATABASE_URL=postgresql+psycopg2://USER%40NOME%20SERV:PASSWORD@NOME-SERVIDOR.postgres.database.azure.com:5432/DBNAME?sslmode=require
# VEREDA_DATABASE_URL = o mesmo (ou só DATABASE_URL: remote_deploy_back.sh duplica em VEREDA_DATABASE_URL).
# Sincronizar a mesma URL nas duas VMs, sem fazer commit de segredos: scripts/push-pg-url-to-syntexa-vms.sh
# Migração de esquema (1× após carga da URL): scripts/migrate-db-on-syntexa-vm.sh
DATABASE_URL=sqlite:///./vereda_ai.db

# === Escala ~10k utilizadores (ligados / fila) — 10k inferências EXATAS ao mesmo tempo ninguém aguenta numa única VM; é fila + vários nós. ===
# 1) PostgreSQL (obrig) + 2) Redis (obrig p/ cache+fila ARQ) + 3) Cloudflare na frente + 4) vários workers e/ou várias VMs com load balancer
# 5) VM "maior" para API: p.ex. Standard_D32s_v5, Standard_D48s_v5, ou múltiplas réplicas. GPU (p.ex. Standard_NC* ou NVadsA10) para o MOTOR de IA, ou API externa (vLLM/Azure)
# 6) GLOBAL_MAX_CONCURRENT_LLM = nº de inferências a correr de VERDADE em paralelo (límite o GPU/CPU; não 10000). Público: resto entra em fila / HTTP 202 / espera
# 7) SESSION_CREATE_PER_IP_HOUR: suba em instalação corporativa (muitas sessões / mesmo IP)
# GLOBAL_MAX_CONCURRENT_LLM=256
# PER_USER_MAX_CONCURRENT_LLM=6
# SESSION_CREATE_PER_IP_HOUR=2000
# UVICORN_WORKERS=8
# SLOT_TIMEOUT_PUBLIC_SEC=120
# LOAD_QUEUE_STRESS_THRESHOLD=0.85
# (Opcional) gunicorn: USE_GUNICORN=1 com UVICORN_WORKERS=16+ em VM grande + PostgreSQL

# === Redis (cache de chat + fila ARQ na Azure: Cache for Redis ou container na mesma VM) ===
# URL acessível a partir da VM (não use Redis só no teu PC).
REDIS_URL=redis://:PASSWORD@YOUR_REDIS_HOST:6379/0
REDIS_CHAT_CACHE_TTL_SEC=120
CHAT_LONG_JOB_THRESHOLD_TOKENS=2500
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# === Azure AI Speech (STT) — transcrição no /v1/multimodal/transcribe e gravações WebM no chat ===
# Portal: criar recurso "Speech" → copiar chave 1 e região (ex.: brazilsouth).
# No servidor Linux: instale `ffmpeg` (apt install ffmpeg) para converter WebM → WAV.
# Opcional: LOCAL_STT_ENDPOINT=http://127.0.0.1:XXXX/transcribe (Whisper HTTP) como fallback.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=brazilsouth
# AZURE_TTS_VOICE=pt-BR-FranciscaNeural

# === Azure Storage — fila de imagens + blob (Container Apps / workers GPU na VM) ===
# Connection string do Storage Account (portal: Access keys). Cria fila `image-jobs` e opcionalmente container blob.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_IMAGE_QUEUE=image-jobs
# AZURE_STORAGE_IMAGE_CONTAINER=syntexa-images

# Produção atrás do Cloudflare: rejeita chamadas diretas ao origin (health/docs liberados)
REQUIRE_CLOUDFLARE=false

# === LLM / Modelos (CPU/GPU na Azure; núcleo proprietário recomendado) ===
# Opções principais para `DEFAULT_LLM`:
# - syntexa_native : motor NLP híbrido interno — sem API de modelo de terceiros como núcleo
# - azure_tgi      : TGI no TEU container/VM (inferência própria)
# - exllama        : gateway ExLlama HTTP na tua infra
# - local_http     : LOCAL_LLM_ENDPOINT (OpenAI-compatible / gateway próprio)
# - remote         : endpoint HTTP do TEU serve_model.py / gateway proprietário
# - dummy          : só dev

# Opcional: gateway HTTP próprio (vLLM, TGI, exllama-server, etc.)
# LOCAL_LLM_ENDPOINT=http://127.0.0.1:8080
LOCAL_HTTP_LLM_MODEL=local
VISION_LLM_MODEL=llava:7b

# Google Custom Search (opcional — busca pública agregada no backend)
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# === Azure - Text Generation Inference (TGI) ou endpoint HTTP compatível ===
# Use quando for hospedar o modelo 13B+ em uma VM com GPU (NVidia A10/A100/4090 etc.)
# Exemplo TGI: endpoint retornando API compatível com TGI /generate ou /v1/models
AZURE_TGI_ENDPOINT=
AZURE_TGI_KEY=
AZURE_TGI_MODEL=llama-13b

# === Azure OpenAI (serviço gerenciado) ===
# Nome do endpoint ou deployment name (se usar Azure OpenAI, configure as chaves no portal)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_ENDPOINT=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Remote generic LLM endpoint (TGI / gateway próprio / outro) ===
# Caso prefira delegar para um endpoint externo (ex.: provedor, outro VPS), configure aqui.
REMOTE_LLM_ENDPOINT=
REMOTE_LLM_MODEL=

# === ExLlama (exllamav2) — endpoint HTTP/REST exposto pelo seu serviço exllama ---
# Se você hospedar ExLlamaV2 (via exllama-server, exllama-webui ou gateway compatível), aponte aqui.
EXLLAMA_ENDPOINT=
EXLLAMA_MODEL=exllama-v2-13b

# === Ollama — GPU/CPU na nuvem (Ollama Cloud) ou modelo na tua VM Azure (:11434) ===
# Cloud (recomendado, sem Docker Ollama no servidor): https://ollama.com — chave em https://ollama.com/settings/keys
# API compatível OpenAI: base SEM /v1 no fim (o código usa .../v1/chat/completions)
OLLAMA_ENDPOINT=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=
# Embeddings open-source: auto = Ollama (/api/embed) → FastEmbed (ONNX) → LOCAL_LLM /v1/embeddings → hash
# EMBEDDING_BACKEND=auto
# OLLAMA_EMBED_MODEL=nomic-embed-text
# FASTEMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_HTTP_ENDPOINT=
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# VM própria na Azure com Ollama a escutar: OLLAMA_ENDPOINT=http://10.x.x.x:11434 (rede interna) ou IP público.
# Só uses ENABLE_LOCAL_LLM_STACK=true se quiseres o container llm-server/docker-compose.yml nesta máquina.

# ── MODO SOBERANO (sem fallback para APIs externas) ─────────
# OWN_MODEL_SOVEREIGN_MODE=true = NUNCA usa OpenAI, Claude, Gemini, DeepSeek, etc.
# Para usar providers externos, defina explicitamente:
#   OWN_MODEL_SOVEREIGN_MODE=false
#   EXTERNAL_PROVIDERS_ENABLED=true
OWN_MODEL_SOVEREIGN_MODE=true
EXTERNAL_PROVIDERS_ENABLED=false

# Chat textual: com OLLAMA_ENDPOINT (ou outro LLM HTTP) configurado, esse endpoint é o motor primário
# de resposta — mesmo se DEFAULT_LLM=syntexa_native (valor legado no .env). Para ser explícito: DEFAULT_LLM=ollama
# DEFAULT_LLM=openai usa OPENAI_ENDPOINT/OPENAI_API_KEY/OPENAI_MODEL.
DEFAULT_LLM=syntexa_native

# === Split Architecture (Railway Gateway + AI Workers) ===
# GATEWAY_MODE=true: Railway roda SOMENTE a camada leve (FastAPI, auth, pagamentos, proxy).
# IA pesada (embeddings, LLM, OCR, TTS, STT) sai para AI Worker ou Local AI.
GATEWAY_MODE=true
# URL do AI Worker (Kaggle, GPU externa, ou VM dedicada). Ex.: https://ai-worker.syntexabr.com.br
AI_WORKER_URL=
AI_WORKER_API_KEY=
# URL do servidor local privado (Ollama, modelos privados). Ex.: http://10.0.0.5:8002
LOCAL_AI_URL=
LOCAL_AI_API_KEY=

# === Fase 2 — orçamento de chat (menos tokens = mais throughput) ===
CHAT_MAX_MESSAGES=12
CHAT_MAX_MESSAGE_CHARS=6000
CHAT_MAX_OUTPUT_TOKENS_DEFAULT=768
CHAT_MAX_OUTPUT_TOKENS_LONG=3072
CHAT_MAX_MODEL_TOKENS=4096
# Respostas «profundas» (tutorial, dissertação, etc.): teto/piso extra — alinhar à janela do modelo (VRAM)
# CHAT_DEEP_RUN_MAX_OUTPUT_TOKENS=12288
# CHAT_DEEP_RUN_MAX_MODEL_TOKENS=12288
# CHAT_DEEP_RUN_MIN_OUTPUT_TOKENS=4096
# CHAT_DEEP_RUN_CONTEXT_EXTRA_TOKENS=4000
# CHAT_DEEP_RUN_KNOWLEDGE_LIMIT=3
# CHAT_DEEP_RUN_MEMORY_TOP_K_EXTRA=1
# CHAT_DEEP_RUN_RAG_TOP_K_EXTRA=2
# CHAT_DEEP_RUN_WEB_MAX_EXTRA=6
# CHAT_DEEP_RUN_SEMANTIC_TOP_K_EXTRA=2
# CHAT_DEEP_RUN_WEB_TIMEOUT_EXTRA_SEC=12
# CHAT_DEEP_RUN_MESSAGE_CHARS_EXTRA=4000
# CHAT_WEB_AUGMENT_MAX_RESULTS_CAP=28
# CHAT_WEB_FAST_MAX_TOTAL=6
# CHAT_WEB_FAST_MAX_TOTAL_DEEP=16
# CHAT_WEB_AUGMENT_TEXT_CHARS=12000
# CHAT_WEB_AUGMENT_TEXT_CHARS_DEEP=22000
# Contrato de qualidade estilo assistente de topo + temperatura estável em pedidos profundos
# CHAT_FRONTIER_PROMPT_ENABLED=true
# CHAT_DEEP_RUN_TEMPERATURE_ADJUST_ENABLED=true
# CHAT_DEEP_RUN_TEMPERATURE_CAP=0.62
# CHAT_AUTO_DOMAIN_MODES_ENABLED=true
CHAT_STRICT_REAL_PROVIDERS=true
CHAT_MEMORY_TOP_K=1
CHAT_RAG_TOP_K=1
CHAT_SHARED_CACHE_TTL_SEC=300
# Janela de contexto aproximada (tokens ~ caracteres / CHAT_APPROX_CHARS_PER_TOKEN) por tier
# CHAT_APPROX_CHARS_PER_TOKEN=4
# CHAT_CONTEXT_APPROX_TOKENS_PUBLIC=8000
# CHAT_CONTEXT_APPROX_TOKENS_AUTH=14000
# CHAT_CONTEXT_APPROX_TOKENS_ADMIN=22000
# CHAT_MAX_MESSAGES_ADMIN_FLOOR=36
# Política de sistema do chat (JSON em config/syntexa_chat_policy.json); perfil por ENVIRONMENT ou override:
# SYNTEXA_CHAT_POLICY_PATH=
# SYNTEXA_CHAT_POLICY_PROFILE=production
# Congelamento de promoções LLM (blue/green, canary): exige header X-Syntexa-Freeze-Bypass
# LLM_PROMOTION_CHANGE_FREEZE=false
# LLM_PROMOTION_FREEZE_BYPASS_SECRET=

# === Fase 3 — estabilidade (slots, prioridade, degradação) ===
GLOBAL_MAX_CONCURRENT_LLM=12
PER_USER_MAX_CONCURRENT_LLM=3
SLOT_TIMEOUT_GOV_SEC=300
SLOT_TIMEOUT_AUTH_SEC=120
SLOT_TIMEOUT_PUBLIC_SEC=45
LOAD_QUEUE_STRESS_THRESHOLD=0.78
SESSION_CREATE_PER_IP_HOUR=40

# ============================================================
# === HYBRID ARCHITECTURE v3.0 — AWS GPU + Local Fallback ====
# ============================================================

# ── AWS GPU Cluster (inferência pesada) ─────────────────────
# URL do cluster GPU na AWS (vLLM / TGI / TensorRT)
# Ex.: http://internal-aws-gpu.syntexabr.com.br:8000 (via Cloudflare Tunnel)
AWS_BASE_URL=http://98.94.86.193:8000
AI_WORKER_URL=
AI_WORKER_API_KEY=

# ── Infra Local Híbrida (fallback) ─────────────────────────
# URL da máquina local com Ollama / llama.cpp / ONNX Runtime
LOCAL_BASE_URL=http://localhost:8002
LOCAL_AI_URL=http://localhost:8002
LOCAL_AI_API_KEY=local-dev-key-change-me

# ── AI Router Engine ────────────────────────────────────────
AI_ROUTER_TIMEOUT_SEC=120.0
AI_ROUTER_FALLBACK_ENABLED=true

# ── Cloudflare Turnstile (anti-bot) ───────────────────────
# Site key pública (frontend): https://dash.cloudflare.com → Turnstile → copiar sitekey
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# Secret key (backend): mesma página → copiar secret key
# TURNSTILE_SECRET_KEY=0x4AAAAAA...

# ── Edge Security (Cloudflare Workers) ──────────────────────
REQUIRE_CLOUDFLARE=false
JWT_EDGE_VERIFY=false
HMAC_VERIFY=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=200
PROXY_TIMEOUT_MS=45000
