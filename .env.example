# Copie para .env e preencha. Nunca commite .env com chaves reais.
# Produção: variáveis são definidas no Hetzner (/opt/syntexa/.env), não na máquina do desenvolvedor.

# === Resend (envio de e-mails) ===
# Chave da API do Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# === Brevo (opcional, prioridade sobre Resend quando configurado) ===
# Chave API: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib_xxxxxxxxxxxx
# E-mail remetente — precisa ser de domínio verificado no Resend.
# Se não configurar, usa onboarding@resend.dev (só funciona para seu próprio e-mail no plano free).
RESEND_FROM_EMAIL=no-reply@syntexabr.com.br
# E-mail destino para notificações internas (admin). Se não configurar, usa VEREDA_ADMIN_EMAIL.
RESEND_TO_EMAIL=admin@syntexabr.com.br

# === Stripe (obrigatório para checkout) ===
STRIPE_SECRET_KEY=sk_live_...ou_sk_test_...
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_MEDIUM=price_xxx
STRIPE_PRICE_MASTER=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Opcional: URL do frontend para redirect após pagamento
FRONTEND_BASE_URL=https://syntexabr.com.br

# === Frontend (build Cloudflare Pages — prefixo NEXT_PUBLIC_) ===
# Opcional: segunda origem da API se a primária falhar (retry + fallback no frontend).
# NEXT_PUBLIC_API_BACKUP_BASE=https://backup-api.example.com

# === Backend ===
VEREDA_SECRET_KEY=...
VEREDA_ADMIN_EMAIL=admin@...
VEREDA_ADMIN_PASSWORD=...

# === Redis (cache de chat + fila ARQ: Hetzner — URL real do seu Redis) ===
# Ex.: Redis gerenciado, ou serviço na rede privada / Docker no VPS (não use loopback do laptop).
REDIS_URL=redis://:PASSWORD@YOUR_REDIS_HOST:6379/0
REDIS_CHAT_CACHE_TTL_SEC=120
CHAT_LONG_JOB_THRESHOLD_TOKENS=2500
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# Produção atrás do Cloudflare: rejeita chamadas diretas ao origin (health/docs liberados)
REQUIRE_CLOUDFLARE=false

# === LLM (Hetzner: Ollama exposto pelo Docker llm-server na porta 11434 do host) ===
# No VPS, use o endereço que o backend resolve até o Ollama (ex.: bridge Docker típica Linux).
OLLAMA_ENDPOINT=http://172.17.0.1:11434
# Modelo menor = menos RAM/CPU por requisição (ex.: llama3.2:1b, phi3, qwen2.5:1.5b)
OLLAMA_MODEL=llama3.2:1b
# Contexto menor no Ollama = inferência mais rápida no mesmo hardware (512–4096)
OLLAMA_NUM_CTX=2048
DEFAULT_LLM=ollama

# === Fase 2 — orçamento de chat (menos tokens = mais throughput) ===
CHAT_MAX_MESSAGES=12
CHAT_MAX_MESSAGE_CHARS=6000
CHAT_MAX_OUTPUT_TOKENS_DEFAULT=768
CHAT_MAX_OUTPUT_TOKENS_LONG=3072
CHAT_MEMORY_TOP_K=1
CHAT_RAG_TOP_K=1
CHAT_SHARED_CACHE_TTL_SEC=300

# === Fase 3 — estabilidade (slots, prioridade, degradação) ===
GLOBAL_MAX_CONCURRENT_LLM=12
PER_USER_MAX_CONCURRENT_LLM=3
SLOT_TIMEOUT_GOV_SEC=300
SLOT_TIMEOUT_AUTH_SEC=120
SLOT_TIMEOUT_PUBLIC_SEC=45
LOAD_QUEUE_STRESS_THRESHOLD=0.78
SESSION_CREATE_PER_IP_HOUR=40
