[Unit]
Description=Syntexa FastAPI Backend (uvicorn)
Documentation=file:///opt/syntexa/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/syntexa
EnvironmentFile=-/opt/syntexa/.env
Environment=PYTHONPATH=/opt/syntexa
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash /opt/syntexa/scripts/run_uvicorn_prod.sh
Restart=always
RestartSec=4
# Logs também em ficheiro (além do journal) para compatibilidade com deploy-syntexa.ps1 logs
StandardOutput=append:/opt/syntexa/backend.log
StandardError=append:/opt/syntexa/backend.log
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
