{
  "name": "syntexa-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/no-local-dev.cjs",
    "build": "node ./scripts/build-with-out-junction.cjs",
    "start": "node ./scripts/no-local-dev.cjs",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:audit": "playwright test e2e/syntexa-site-audit.spec.js",
    "test:e2e:local": "cross-env SYNTEXA_E2E_BASE=http://127.0.0.1:3456 playwright test e2e/syntexa-site-audit.spec.js",
    "test:e2e:full": "playwright test e2e/syntexa-full-checkup.spec.js",
    "test:e2e:exports": "playwright test e2e/export-content-validation.spec.js",
    "test:e2e:downloads": "playwright test e2e/download-artifacts.spec.js",
    "test:e2e:all": "playwright test e2e/syntexa-site-audit.spec.js e2e/export-content-validation.spec.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heyputer/puter.js": "^2.2.15",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@xenova/transformers": "^2.17.2",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "framer-motion": "latest",
    "gsap": "^3.15.0",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.44",
    "lenis": "^1.3.23",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "cross-env": "^10.1.0",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "wrangler": "4.0.0",
    "xlsx": "^0.18.5"
  }
}
