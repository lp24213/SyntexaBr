### Syntexa Own Model Runtime
# Não remove o stack atual; apenas habilita tuning da IA proprietária.

OWN_MODEL_MAX_NEW_TOKENS=1536
OWN_MODEL_TEMPERATURE=0.82
OWN_MODEL_TOP_K=96
OWN_MODEL_STRICT_NO_FALLBACK=1
PREFER_EXTERNAL_LLM_WHEN_CONFIGURED=0

### Se quiser alternar backend para endpoint do modelo próprio
# DEFAULT_LLM=local_http
# LOCAL_LLM_ENDPOINT=http://127.0.0.1:9000
# LOCAL_HTTP_LLM_MODEL=syntexa_small
