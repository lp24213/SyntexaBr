# ============================================================
# SyntexaBR — .gitignore
# NUNCA commite .env com chaves reais!
# ============================================================

# Segredos e variáveis de ambiente
.env
.env.*
!.env.example
azure-vm-host.txt
config/syntexa-pg.url.local
.syntexa-apply-pg.url.tmp
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
*.so
*.dylib
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.coverage

# Node / Next.js
node_modules/
.next/
# Instaladores Electron na API — binários grandes são versionados para deploy no Railway
# vereda_backend/static/desktop/* — NÃO ignorar: necessário para Railway servir os ficheiros
frontend/public/download/*
!frontend/public/download/.gitkeep
out/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build artefatos
dist/
*.tsbuildinfo

# IPs cadastrados pelo admin no servidor (não versionar)
vereda_backend/data/admin_allowed_ips.json

# Banco de dados local
*.db
*.sqlite
*.sqlite3

# Deploy / CI artefatos
syntexa-deploy.tar.gz
*.tar.gz
*.zip
*.log
backend.log
nohup.out

# Cert exportado manualmente (pode conter chave privada)
Certificate.zip
certificate_extracted/

# Chaves e certificados
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_ed25519
*.pub

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Cloudflare / Wrangler
.wrangler/

# Playwright E2E
playwright-report/
test-results/

# Desktop binaries (too large for GitHub)
desktop/release/
desktop/dist-*/
desktop/dist/
*.msi
*.exe
temp_download.exe
test_download.exe
