# ✅ BACKEND CONFIGURATION (.env.example)
# Copy to .env and fill with production values

# ===== SERVER =====
PORT=3001
NODE_ENV=production

# ===== REDIS (REQUIRED FOR QUEUE AND RATE LIMITING) =====
# Format: redis://:password@host:port/db
# Railway: redis://default:PASSWORD@container.railway.app:6379
REDIS_URL=redis://redis:6379

# ===== DATABASE (PostgreSQL) =====
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/syntexa

# ===== QUEUE CONFIGURATION =====
QUEUE_NAME=stt_jobs
QUEUE_EVENTS_CHANNEL=stt_events
MAX_JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# ===== RATE LIMITING =====
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# ===== FILE UPLOAD =====
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=40

# ===== API CONFIGURATION =====
ALLOWED_ORIGINS=https://syntexabr.com.br,https://www.syntexabr.com.br,https://app.syntexabr.com.br

# ===== LOGGING =====
LOG_LEVEL=info

# ===== AI/ML ENDPOINTS (if needed) =====
# STT_API_URL=http://stt-service:8000
# TTS_API_URL=http://tts-service:8000
# LLM_API_URL=http://llm-service:8000
