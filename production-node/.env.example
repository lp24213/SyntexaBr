NODE_ENV=production
REDIS_URL=redis://redis:6379

QUEUE_NAME=stt_jobs
QUEUE_EVENTS_CHANNEL=stt_events
WORKER_CONCURRENCY=2
STT_TIMEOUT_MS=240000
MAX_JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE=cuda
STT_LANGUAGE=pt

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
WS_CORS_ORIGIN=https://syntexabr.com.br
