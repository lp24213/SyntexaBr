  "analysis": {
    "real_backend_structure": "MULTI-TIER HYBRID ARCHITECTURE",
    "primary_layer": {
      "component": "vereda_backend (FastAPI)",
      "responsibility": "Chat, IA, subscriptions, all main features",
      "criticality": "CRITICAL - This is THE main backend"
    },
    "specialized_layers": {
      "llm_modules": {
        "component": "llm-* modules",
        "responsibility": "Specialized LLM processing, reasoning, multimodal",
        "integration": "Imported by vereda_backend services",
        "note": "These are libraries/modules, not standalone services"
      },
      "nodejs_layer": {
        "component": "production-node (Express)",
        "responsibility": "Job queues, real-time communication, high-concurrency tasks",
        "integration": "Communicates with vereda_backend via Redis/Postgres"
      },
      "edge_layer": {
        "component": "cloudflare-workers",
        "responsibility": "CDN, caching, edge routing",
        "integration": "Routes traffic to main backends"
      }
    },

    "data_flow": {
      "user_request": "Browser/Client → Cloudflare Workers → Express API (production-node) or FastAPI (vereda_backend)",
      "ai_processing": "FastAPI receives request → Routes via ai_router → Calls llm-* modules → Returns response",
      "background_jobs": "Job created in FastAPI → BullMQ queue (Redis) → Node.js worker processes → Updates DB",
      "real_time": "Socket.IO in Express → Broadcasts via Redis Pub/Sub → WebSocket to client"
    },

    "what_is_duplicated": {
      "findings": [
        "MAJOR DUPLICATION: Both FastAPI and Express have chat endpoints - consolidation needed",
        "Router logic exists in multiple places (llm-router, ai_router.py, Express routes)",
        "Config scattered across vereda_backend/core, infrastructure/*, and .env files",
        "Authentication duplicated in FastAPI + Express + possibly Cloudflare",
        "Rate limiting implemented in multiple places (FastAPI + Express middleware)"
      ],
      "recommendation": "Consider merging Express into FastAPI or creating clear responsibility boundaries"
    },

    "what_needs_consolidation": [
      "Chat endpoints - Consolidate into single authoritative endpoint",
      "Authentication - Move to shared layer (middleware or gateway)",
      "Rate limiting - Centralize in single middleware",
      "Configuration - Move all to centralized config service",
      "Model routing - Single source of truth for model selection",
      "Database queries - Some logic might be duplicated between FastAPI and queries"
    ],

    "critical_integration_points": [
      "vereda_backend.services.chat_engine ← Receives all chat requests",
      "vereda_backend.core.ai_router ← Routes to correct model",
      "vereda_backend.db.models ← All data persists here",
      "Redis cache ← Shared between FastAPI and Express",
      "BullMQ queues ← FastAPI submits jobs, Express workers process",
      "PostgreSQL ← Primary data store for all services"
    ],

    "backend_deployment_notes": {
      "current_state": "Multi-process deployment",
      "components_running": [
        "FastAPI app (main backend)",
        "Express app (queues + real-time)",
        "BullMQ workers (background jobs)",
        "Celery workers (if configured)",
        "Cloudflare Workers (edge)"
      ],
      "platform": "Railway.app (current production)"
    }
  },

