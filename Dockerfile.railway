# syntax=docker/dockerfile:1
# Syntexa Railway Gateway — Container LEVE (sem IA pesada)
FROM python:3.12-slim-bookworm
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.railway.txt .
RUN pip install --no-cache-dir -r requirements.railway.txt \
 && pip install --no-cache-dir "psycopg2-binary>=2.9.9"

# Código do gateway + vereda_ai (sem modelo pesado — LLM fica na AWS)
COPY vereda_backend ./vereda_backend
COPY vereda_ai ./vereda_ai
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV UVICORN_WORKERS=1
ENV UVICORN_TIMEOUT_KEEPALIVE=120
ENV GATEWAY_MODE=false

# Railway injeta PORT dinamicamente; default 8000 para compatibilidade local
EXPOSE 8000
ENV PORT=8000

# Healthcheck rápido — startup deve ser <10s
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=2 \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
