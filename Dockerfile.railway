# syntax=docker/dockerfile:1
# Syntexa Railway Production API — Node Express service for /api/stt and health checks
FROM node:22-alpine

WORKDIR /app

COPY production-node/api/package.json production-node/api/package-lock.json* ./
RUN npm install --omit=dev

COPY production-node/api/src ./src

EXPOSE 3001
ENV PORT=3001
ENV NODE_ENV=production

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=2 \
  CMD node -e "const http=require('http'); const req=http.get('http://127.0.0.1:3001/health', res=>{ res.resume(); process.exit(res.statusCode===200?0:1); }); req.on('error', ()=>process.exit(1)); req.end();"

CMD ["npm", "start"]
