{
  "name": "syntexa-whatsapp-saas",
  "version": "1.0.0",
  "description": "WhatsApp Business SaaS backend powered by Syntexa AI",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "worker": "node src/worker/queue-worker.js",
    "dev:worker": "node --watch src/worker/queue-worker.js"
  },
  "keywords": [
    "whatsapp",
    "saas",
    "ai",
    "syntexa",
    "fastify",
    "typescript"
  ],
  "author": "Syntexa",
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.3.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "pg": "^8.15.0",
    "redis": "^4.7.0",
    "axios": "^1.9.0",
    "uuid": "^11.1.0",
    "dotenv": "^16.5.0",
    "zod": "^3.24.0",
    "crypto-js": "^4.2.0",
    "winston": "^3.17.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/crypto-js": "^4.2.0"
  }
}
